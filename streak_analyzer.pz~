                "zone": [r["p99"], r["max"]]
            },

            # tail mask ratio: tail_mass = P(delta > p90) | extreme_mass = P(delta > p99)
            # Next is regime mass ratio for each streak
            #  "normal": % below p90,
            #  "burst": % p90–p99,
